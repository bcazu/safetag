# SafeTag — variables de entorno
# Copiar a .env (raíz) y a apps/*/.env.local según aplique. Nunca commitear valores reales.

# --- Frontend (Vite expone solo variables con prefijo VITE_) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Edge Functions (se configuran con `supabase secrets set`, no viajan al cliente) ---
# Secreto compartido con el REST Service de Kobo (inventar uno largo y aleatorio)
KOBO_WEBHOOK_SECRET=

# --- Scripts de servidor / integración con Kobo (nunca en el cliente) ---
# KoboToolbox → Account Settings → Security → API Key
KOBO_API_TOKEN=
# UID del formulario (aparece en la URL del proyecto en Kobo)
KOBO_ASSET_UID=

# --- Mapas (solo si se usa Stadia Maps como proveedor de tiles; OpenFreeMap no requiere key) ---
VITE_STADIA_API_KEY=
